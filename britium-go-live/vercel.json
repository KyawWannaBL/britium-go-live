{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/map-lib/leaflet.js",
      "destination": "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    },
    {
      "source": "/map-lib/leaflet.css",
      "destination": "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    },
    {
      "source": "/map-tiles/normal/:z/:x/:y.png",
      "destination": "https://a.tile.openstreetmap.org/:z/:x/:y.png"
    },
    {
      "source": "/map-tiles/normal-fallback/:z/:x/:y.png",
      "destination": "https://b.tile.openstreetmap.org/:z/:x/:y.png"
    },
    {
      "source": "/map-tiles/street/:z/:x/:y.png",
      "destination": "https://a.tile.openstreetmap.org/:z/:x/:y.png"
    },
    {
      "source": "/map-tiles/street-fallback/:z/:x/:y.png",
      "destination": "https://b.tile.openstreetmap.org/:z/:x/:y.png"
    },
    {
      "source": "/map-tiles/earth/:z/:x/:y.jpg",
      "destination": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/:z/:y/:x"
    },
    {
      "source": "/map-tiles/earth-fallback/:z/:x/:y.jpg",
      "destination": "https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/:z/:y/:x"
    },
    {
      "source": "/supabase/:path*",
      "destination": "https://dltavabvjwocknkyvwgz.supabase.co/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/map-tiles/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/supabase/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ]
}
